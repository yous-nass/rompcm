def linear(idx:float, Nt:int):
	#print(train_indices)
	mu = Th[train_indices]
	for i in range(len(train_indices)):
		#print(id, idx, Th[id] , Th[idx] , Th[id+1])
		if mu[i] < Thtest[idx] < mu[i+1]:	
			T_l = ((Th[idx] - mu[i])*data[train_indices[i+1], :Nt] 
				  - (Th[idx] - mu[i+1])*data[train_indices[i], :Nt]) / (mu[i+1] - mu[i])
			err = estimator_cond(T_l, data[idx], Th[idx], dt)
			print("linear interpolation, parameter:", Th[idx], "errors ", err)
			return err


