def compute_R(T1, T2, T3, phi, mu):
	bdf = c1 * (T1 + S(T1)) - c2 * (T2 + S(T2)) + c3 * (T3 + S(T3))
	r_time = phi.T @ (M @ bdf)
	r_diff = IPr * (phi.T @ (K @ T1))
	r_bc   = 0. #IPr * (phi.T @ (K @ (T1* g1[0] - mu * g1[0])))
	R = r_time + r_diff + r_bc
	return Mr_inv @ R

def compute_dR_da(
	T: np.ndarray,
	phi: np.ndarray,
) -> np.ndarray:
	"""
	dR/da = c1 * phi.T @ M @ (phi + dS/da)
		  + 2 * IPr * phi.T @ K @ phi

	shape: (r, r)
	"""
	dR   = c1  * (Mr + phi.T @ (M @ (dS(T) @ phi)))
	dR  += IPr * Kr
	return dR


def make_F_and_jac(
	a_rbf, T1, T2, T3, phi, lam, mu
):
	"""
	Returns (fun, jac) callables for scipy.optimize.least_squares.

	F(a) = [ a - a_rbf        ]   fit block
		   [ sqrt(lam) * R(a) ]   physics block

	jac(a) = [ I                      ]
			 [ sqrt(lam) * dR/da(a)   ]
	"""
	sl = np.sqrt(lam)

	def fun(a):
		R = compute_R(T1, T2, T3, phi, mu)
		return np.concatenate([a - a_rbf, sl * R])

	def jac(a):
		dR = compute_dR_da(T1, phi)
		r  = len(a_rbf)
		J_top = np.eye(r)
		J_bot = sl * dR
		return np.vstack([J_top, J_bot])

	return fun, jac


