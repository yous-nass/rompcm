from rompcm.tools import estimator_cond, plot_snapshots


def predict(datatest, mutest, Nt, has_plot=False):
	# Predict reduced coefficients
	theta = (datatest - trainer.pod.samples_mean) @ trainer.pod.phi
	theta_pred, err = trainer.rbf.predict_theta(mutest, Nt, theta)
	# Reconstruct full field
	pred = theta_pred @ trainer.pod.phi.T + trainer.pod.samples_mean
	pred += mutest*trainer.g1
	
	datatest += mutest*trainer.g1
	l2_err = estimator_cond(pred, datatest, mutest, dt)
	print(f"parameters µ {mutest}, Errors:: {err, l2_err}") 
	if has_plot:
		plot_snapshots(datatest, pred, mutest, 'FOM', 'POD-RBF')
	return pred


