def savebasis(basis, mean):
	Saverombasis = r"""
		IMPORT "io.edp"
		int r = importVar("r");
		
		real xl=0,xr=1.,yl=0,yr=1.; // Square dimension [xl,xr]x[yl,yr]
		int nbseg = 60;
		mesh Mh = square(nbseg,nbseg,[xl+x^1.93*(xr-xl),yl+y*(yr-yl)]);
		savemesh(Mh, "mesh_online.msh");
		fespace Vh(Mh, P2);   
		Vh phih, Tmh;
		phih[] = importArray("phi"); Tmh[] = importArray("Tm");
		plot(phih, dim=2, fill=1, value=1, cmm="phi0 from Python", wait=1);


		string path = "pod_cond_basis/";
		string namef= path+"phi"+r+".txt";
		ofstream f(namef);
		f.precision(16);
		// Vh u = phih;
		for(int i=0; i < Vh.ndof; i++)
			f<<phih[][i]<<endl;
		f<<endl; 


		if (r==0){
			string namep= path+"mean.txt";
			ofstream fm(namep);
			// Vh T = Tmh;
			fm.precision(16);
			for(int i=0; i < Vh.ndof; i++)
				fm<<Tmh[][i]<<endl;
			fm<<endl; 
		}
