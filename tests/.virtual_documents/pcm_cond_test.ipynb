def S(T):
	return Ste - Ste * 0.5 * (1.0 + np.tanh((eps - T) / eps))
 
def dS(T):
	return 0.5 * Ste / eps / np.cosh((eps - T) / eps) ** 2
 
def d2S(T):
	"""Second derivative d^2S/dT^2 — needed for the analytic Hessian."""
	th = np.tanh((eps - T) / eps)
	return Ste / eps**2 * th / np.cosh((eps - T) / eps) ** 2









def estimator_cond(T_r, T_h, beta0):

	residualT = f"""
		IMPORT "io.edp"

		load "medit"
		load "bfstream"
		real beta = {beta0};
		real dtt = {dt};

		include "{TESTSDIR}/Macro_operator.idp"
		include "{TESTSDIR}/param_phys.inc"

		mesh Mh = ThBackup;
		fespace Vh(Mh, P2);   

		Vh T0h, T1h, T2h, Thfh, g;

		T0h[] = importArray("T0"); T1h[] = importArray("T1"); 
		T2h[] = importArray("T2"); Thfh[] = importArray("Thf");
		g[] = importArray("g1");

		real cc1=1.5/dtt, cc2=-2./dtt, cc3=0.5/dtt;

		Vh rt, TT;
		varf rhs(rt, TT) = int2d(Mh, qforder=6)( 
						 ( cc1*(T2h + S(T2h)) + cc2*(T1h + S(T1h)) + cc3*(T0h + S(T0h)) )*TT 
						 + grad(T2h)'*grad(TT)*IPr  
						 )
						 // + on(4, rt=T2h - beta)
						 ;
						
		Vh RHS = rhs(0, Vh);
		// cout << "maxvalue " <<  RHS.max << "minvalue " << RHS.min << endl;
		// cout << sqrt(RHS'*RHS) <<endl;
		real resh = int2d(Mh, qforder=6)(RHS * RHS) ;           
		// RHS'*(M^-1*RHS);
		// cout << "rhs norm: " << rhsnorm << endl;
		// real resh = RHS'*RHS;
		
		real err = 0 ;
		exportVar(resh); 
		exportVar(err);
	"""
	
	runner1 = FreeFemRunner(residualT)
	err_l2 = 0.; res_h = 0.
	Nt=0
	for i in range(2, T_r.shape[0]):
		runner1.import_variables(beta0=beta0, T0=T_r[i-2],T1=T_r[i-1], T2=T_r[i], Thf=T_h[i], g1=g1[0])

		exports = runner1.execute(verbosity=0)
		res_h += exports["resh"]
		err_l2 += exports["err"]
		Nt+=1

	return (err_l2/Nt)**0.5, (res_h/Nt)**0.5





def compute_residual(T2, T1, T0, mu):
	Tmean =  mu*g1[0]  + Tbar[0]
	Tt2 = T2 - Tmean
	Tt1 = T1 - Tmean
	Tt0 = T0 - Tmean

	bdf = c1 * (Tt2 + S(T2)) - c2 * (Tt1 + S(T1)) + c3 * (Tt0 + S(T0))
		  
	R = M @ bdf  + IPr * K @ Tt2 + IPr*K @ Tmean 
	return R





