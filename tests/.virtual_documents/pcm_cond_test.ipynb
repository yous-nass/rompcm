def residualh_bc(Tr, mu, verbose=False):
	R2 = 0.; nt=0
	for n in range(Tr.shape[1]-2):
		Rpde = 0
		T2 = Tr[:,n+2]; T1 = Tr[:,n+1]; T0 = Tr[:,n]

		bdf  = c1*(T2+S(T2)) - c2*(T1+S(T1)) + c3*(T0+S(T0))
		Rpde = M @ bdf + IPr*K @ T2

		Rpde[bc_dofs] = (T2[bc_dofs] - mu)
		R = Minv(Rpde)
		R2 += R.T @ (M @ R) 
		
		nt += 1
		# Calculate the root-mean-square over all time steps
		total_residual = np.sqrt(R2 / nt)
	
		if verbose:
			print(f"  PDE residual: {total_residual:.4e}")
		
	return total_residual


def relativel2error(Tr, Tref):
	err =0; nt=0
	for n in range(2, Tr.shape[-1]):
		errl2 = Tr[:,n] - Tref[:,n]
		errl2 = errl2.T @ (M @ errl2)
		err += errl2 / ( Tref[:,n].T @ (M @ Tref[:,n]))
		nt  += 1
	return np.sqrt(err / nt)


def residualh(Tr, mu):
	R2 = 0.; nt=0
	print(Tr.shape)
	for n in range(Tr.shape[1]-2):
		
		T2 = Tr[:,n+2]; T1 = Tr[:,n+1]; T0 = Tr[:,n]
		bdf = (  c1 * (T2 + S(T2)) - c2 * (T1 + S(T1))
				+ c3 * (T0 + S(T0)) )
		# R = compute_residual(T2, T1, T0, mu)
		R = M @ bdf  + IPr * K @ T2
		R2 += R.T @ (M @ R )
		nt += 1
		
	return np.sqrt(R2 / nt) 


