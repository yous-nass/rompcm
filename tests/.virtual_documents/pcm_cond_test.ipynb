def residualG(Tr, mu, lam):
	"""
	Full projected BDF2 residual with BC enforcement.

	R_i = c1*(T1 + S(T1), phi_i)_M
		- c2*(T2 + S(T2), phi_i)_M
		+ c3*(T3 + S(T3), phi_i)_M
		+ IPr*(grad T1, grad phi_i)        <- diffusion of full field
		+ IPr*(grad(T1 - mu*g1), grad phi_i) <- BC residual penalty

	The BC residual vanishes exactly when T1 = mu*g1 + homogeneous part,
	i.e. when the lifting decomposition is exactly satisfied.
	It is nonzero when T1 deviates from the correct BC value mu on wall 4.

	Parameters
	----------
	T1, T2, T3 : (Ndof,)  full FOM-space fields at t^{n+1}, t^n, t^{n-1}
	mu         : scalar   current parameter value
	g1         : (Ndof,)  lifting function DOF vector
	phi        : (Ndof, Nr)  POD basis
	M, K       : (Ndof, Ndof)  FOM mass and stiffness matrices
	IPr        : scalar   1/(Re*Pr)
	c1,c2,c3   : BDF2 coefficients  3/(2dt), 2/dt, 1/(2dt)
	Ste, eps   : phase-change parameters

	Returns
	-------
	scalar : 0.5 * ||R||^2_M  (M-weighted squared residual norm)
	"""
	
	for n in range(Tr.shape[-1]-2):
		T1 = Tr[:,n+2]; T2 = Tr[:,n+1]; T3 = Tr[:,n]
	
		# ── Time + phase-change term ──────────────────────────────────
		# BDF2:  c1*(T1+S(T1)) - c2*(T2+S(T2)) + c3*(T3+S(T3))
		bdf = (  c1 * (T1 + S(T1))
		   - c2 * (T2 + S(T2))
		   + c3 * (T3 + S(T3)) )
		r_time = phi.T @ (M @ bdf)                 # (Nr,Nt)

		# ── Diffusion of the full field T1 ────────────────────────────
		r_diff = IPr * phi.T @ (K @ T1)            # (Nr,Nt)

		# ── BC residual: stiffness of the BC error (T1 - mu*g1) ───────
		#r_bc = IPr * phi.T @ (K @ ((T1 - mu) * g1[0,:,None])) # (Nr,Nt)
		r_bc = lam*phi.T @ ( M @ ((T1 - mu) * g1[0,:])) # (Nr,Nt)
	
		# ── Full residual vector ──────────────────────────────────────
		R = r_time + r_diff + r_bc                 # (Nr,Nt)

		# Return the M-weighted squared norm  R^T M_r R
		# (M_r = phi^T M phi is the reduced mass, but since phi is
		#  M-orthonormal, M_r = I and this reduces to R^T R)
		#Mr = phi.T @ (M @ phi)                     # (Nr, Nr)
		# R  = R.T @ (Mr @ R)
		#R = np.linalg.solve(Mr, R)
		#R2 = R.T @ (Mr @ R)
		#print(np.max(R))
		#assert False
		#return np.sqrt(R.mean((0, 1)))
		#R2 = np.sum(R * (Mr @ R), axis=0)
	n += 1		
	return np.sqrt(np.mean(R**2) / n)


