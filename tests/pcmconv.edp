while (t<tmax){
   u1pp[]=u1p[];
   u1p[]=u1[];
   t+=dt;
   
   err=1.;
   for (int niter=0;niter<newtonMax;niter++){
      ffddmbuildrhs(PB,VarfrhsPCM,rhs)
      {
         uw1[] = u1[];
         FEVhi [u1,u2,p,T];
         PBfromVhi(uw1[],FEVhi,u1[])
         ffddmsetup(PB,FE,VarfPCM,null)
      }
      tolGMRES = (err>1e-2 ? 1e-8: (err>1e-4 ? 1e-9 : 1e-10) );
      uw1[] = PBfGMRES(u1[],rhs,tolGMRES,maxitGMRES,"left");
      u1[] -= uw1[];
      errparal=u1[].linfty;
      mpiAllReduce(errparal,err,mpiCommWorld,mpiMAX);

      u1[] = uw1[];
      if(mpirank==0) cout<<"iter Newton = "<<niter<<", err= "<<err<<"/"<<tolNewton<<endl;
      if(err < tolNewton) break;
