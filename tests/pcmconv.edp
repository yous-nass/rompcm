// POD Galerkin 
// load "PETSc"
load "medit"
load "bfstream"
load "shell"
load "lapack"
load "iovtk"
string linkCM="../";
macro dimension 2// EOM 

// -----------------------------
// PARAMETERS
// -----------------------------
real beta = 1.005;
real eps = 0.01, Ste = 1./0.045, Pr=56.2,Ra=3.27e5;
real IRa = Ra/Pr, IRe = 1., IPr=1./56.2;

// Carman-Kozeny ---------------------------------------
real CCK = 1e6 , bmushy = 1e-7, gamma = 1e-7;

real tmin = 2.1, tmax = 13.1, dt=0.5, t = 2.6;
real c1 = 3.0/(2.0*dt);
real c2 = -2.0/dt;
real c3 = 1.0/(2.0*dt);

int maxitGMRES=200, newtonMax=20;
real tolNewton = 1.e-6;
real err,errparal,tolGMRES;

mesh Mh = readmesh("mesh_online.msh"); 
fespace Vh(Mh, P2);
fespace Wh(Mh, P1);
// ----------------------------------
// Load reference solutions
// ----------------------------------
string path0 = "../data/PCMconv/";

/* load velocity and temperature */
ifstream f0(path0+"Th_"+beta+"/UVT.t."+tmin+".txt");
ifstream f1(path0+"Th_"+beta+"/UVT.t."+t+".txt");
ifstream f2(path0+"Th_"+beta+"/UVT.t."+tmax+".txt");

/* load pressure */
ifstream fp0(path0+"Th_"+beta+"/P.t."+tmin+".txt");
ifstream fp1(path0+"Th_"+beta+"/P.t."+t+".txt");
ifstream fp2(path0+"Th_"+beta+"/P.t."+tmax+".txt");

Vh v01, v02, T00, v11, v12, T11, v21, v22, T22;
for (int j=0; j<Vh.ndof; j++) {
    f0 >> v01[][j] >> v02[][j] >> T00[][j];
    f1 >> v11[][j] >> v12[][j] >> T11[][j];
    f2 >> v21[][j] >> v22[][j] >> T22[][j];
}

Wh p00, p11, p22;
for (int j=0; j<Wh.ndof; j++) {
    fp0 >> p00[][j];
    fp1 >> p11[][j];
    fp2 >> p22[][j];
}
// plot(T00,dim=2,value=1,fill=1,cmm="final Temperature");

// ----------------------------------
// Phase-change operators
// ----------------------------------
macro S(T)  ( Ste - Ste*0.5*(1.+tanh((eps - T)/eps)) ) //
macro dS(T) ( 0.5*Ste/eps/pow(cosh((eps - T)/eps),2) ) //
macro fB(T)  (IRa*T)//
macro dfB(T) (IRa)//

macro Fmushy(T)( 1. - 0.5*(1.+tanh((eps-T)/eps)) ) // 
macro dFmushy(T)(0.5/eps/pow(cosh((eps-T)/eps),2) ) // 
macro Amushy(T)(-CCK * pow(1.-Fmushy(T),2) / ( pow(Fmushy(T),3)+bmushy ))//
macro dAmushy(T)(2.*dFmushy(T)*(CCK*(1.-Fmushy(T))-1.5*Amushy(T)*pow(Fmushy(T),2))/(pow(Fmushy(T),3)+bmushy))// 


/* macro for the gradient = a vector of components [du/dx, du/dy] */
macro grad(u) [dx(u),dy(u)]//

/* macro for the tensor (\nabla u) with u=[u1,u2] a vector 
   # is the symbol for concatenation, u#1 => u1, u#2 => u2
   the results is a 2*2 matrix
*/
macro Grad(u) [grad(u#1),grad(u#2)]//

/* macro for the divergence of a vector u=[u1,u2] */
macro div(u)(dx(u#1)+dy(u#2))//

/* macro for u*(\nabla)(v), with v a scalar */
macro ugrad(u,v)([u#1,u#2]'*grad(v))//

/* macro for u*(\nabla)(v), with v=[v1,v2] a vector */
macro UgradV(u,v) [ugrad(u,v#1),ugrad(u,v#2)]//

/* Operators for the variational formulation of the 
   Navier-Stokes equations (see text)
   the operator : is the (second order) tensor contraction */
macro a(u,v)((Grad(u):Grad(v)))//
macro b(u,q)(-div(u)*q)//

int[int] wall = [1,2,3,4];
macro bcu1()on(wall,uw1=0)//
macro bcu2()on(wall,uw2=0)//
macro bcT()on(4,Tw=beta)// 

/*
// -------------------------------------
// DDM version
// -------------------------------------
include "ffddm.idp"
ffddmverbosity=3;

macro def(i)[i, i#B, i#C, i#D]// EOM // vector field definition
macro init(i)[i, i, i, i]// EOM // vector field initialization

func Pk = [P2, P2, P1, P2];
fespace WhBackup(Mh,Pk);
fespace Wh1Backup(Mh,P1);
// we build the parallel mesh and it's fespace 
ffddmbuildDmesh(M,Mh,mpiCommWorld)
ffddmbuildDfespace(FE,M,real,def,init,Pk)
