macro VarfPCM(varfName, meshName, VhName)
   varf varfName([uw1,uw2,pw,Tw],[v1,v2,q,TT])
      = int2d(meshName,qforder=6)( b(uw,q) - gamma*pw*q
         + c1*[uw1,uw2,Tw]'*[v1,v2,TT] + IRe*a(uw,v) + b(v,pw) - dfB(T)*Tw*v2
         - Amushy(T)*[uw1,uw2]'*[v1,v2] - dAmushy(T)*Tw*[u1,u2]'*[v1,v2]
         + ugrad(u,Tw)*TT + ugrad(uw,T)*TT + grad(Tw)'*grad(TT)*IPr
         + c1*dS(T)*Tw*TT )
      + bcu1 + bcu2 + bcT;
// EOM

macro VarfrhsPCM(varfName, meshName, VhName)
   varf varfName([uw1,uw2,pw,Tw],[v1,v2,q,TT])
      = int2d(meshName,qforder=6)( ugrad(u,T)*TT - [u1,u2]'*[v1,v2]*dAmushy(T)*T
         - dfB(T)*T*v2 + fB(T)*v2
         - c2*[u1p,u2p,Tp]'*[v1,v2,TT] - c3*[u1pp,u2pp,Tpp]'*[v1,v2,TT]
         + c1*(dS(T)*T*TT - S(T)*TT)- c2*S(Tp)*TT - c3*S(Tpp)*TT )
      + bcu1 + bcu2 + bcT;
// EOM

FEVhi [u01, u02, p0, T0] = [v01, v02, p00, T00],
      [u11, u12, p1, T1] = [v11, v12, p11, T11] ;

real[int] rhs(1);
