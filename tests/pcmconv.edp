   } // END Newton loop
   cout << "        " <<endl;
   PBfromVhi(u1[],WhBackup,u1Backup[])
   plot(TBackup,dim=2,value=1,fill=1,cmm="final Temperature");
}
real errL2;
errL2 = sqrt( int2d(Mh, qforder=6)((TBackup - T22)^2) / int2d(Mh, qforder=6)(T22^2) );
cout << "Relative T L2 error = " << errL2 << endl;

errL2 = sqrt( int2d(Mh, qforder=6)((u1Backup - v21)^2) / int2d(Mh, qforder=6)(v21^2) );
cout << "Relative u1 L2 error = " << errL2 << endl;

errL2 = sqrt( int2d(Mh, qforder=6)((u2Backup - v22)^2) / int2d(Mh, qforder=6)(v22^2) );
cout << "Relative u2 L2 error = " << errL2 << endl;

*/

fespace VVh(Mh,[P2,P2,P1,P2]);

VVh [u1,u2,p,T], [u1p,u2p,pp,Tp], [u1pp,u2pp,ppp,Tpp];
VVh [uw1,uw2,pw,Tw], [v1,v2,q,TT];

[u1,u2,p,T]     = [v11,v12,p11,T11];
[u1p,u2p,pp,Tp] = [v01,v02,p00,T00];

while (t < tmax)
{
    // time update
    u1pp[] = u1p[]; u1p[]=u1[]; 
    
    t += dt;
    cout << "Time = " << t << endl;

    real err = 1.0;

    for (int niter = 0; niter < newtonMax; niter++)
    {
        varf Jacobian([uw1,uw2,pw,Tw],[v1,v2,q,TT])
            = int2d(Mh,qforder=6)( b(uw,q) - gamma*pw*q
               + c1*[uw1,uw2,Tw]'*[v1,v2,TT] + IRe*a(uw,v) + b(v,pw) - dfB(T)*Tw*v2
               - Amushy(T)*[uw1,uw2]'*[v1,v2] - dAmushy(T)*Tw*[u1,u2]'*[v1,v2]
               + ugrad(u,Tw)*TT + ugrad(uw,T)*TT + grad(Tw)'*grad(TT)*IPr
               + c1*dS(T)*Tw*TT )
            + bcu1 + bcu2 + on(4,Tw=0) ;

        varf Residual([uw1,uw2,pw,Tw],[v1,v2,q,TT])
            = int2d(Mh,qforder=6)( b(u,q) - gamma*p*q
               + c1*[u1,u2,T]'*[v1,v2,TT] + IRe*a(u,v) + b(v,p) - fB(T)*v2
               - Amushy(T)*[u1,u2]'*[v1,v2] 
               + ugrad(u,T)*TT + grad(T)'*grad(TT)*IPr 
               + c2*[u1p,u2p,Tp]'*[v1,v2,TT] + c3*[u1pp,u2pp,Tpp]'*[v1,v2,TT]
               + c1*S(T)*TT + c2*S(Tp)*TT + c3*S(Tpp)*TT )
            + bcu1 + bcu2 + on(4,Tw=0) ;
       
        matrix A = Jacobian(VVh,VVh);
        set(A, solver=UMFPACK);
        
        real[int] rhs = Residual(0,VVh);

        uw1[] = A^-1 * rhs;
        
        u1[] -= uw1[];

        err = uw1[].linfty;

        cout << "Newton iter " << niter << " |delta|_inf = " << err << endl;

        if (err < tolNewton) break;
        assert(err < 1e10);
    }

    plot(T, fill=1, value=1, cmm="Temperature");
}
real errL2;
errL2 = sqrt( int2d(Mh, qforder=6)((T - T22)^2) / int2d(Mh, qforder=6)(T22^2) );
cout << "Relative T L2 error = " << errL2 << endl;

errL2 = sqrt( int2d(Mh, qforder=6)((u1 - v21)^2) / int2d(Mh, qforder=6)(v21^2) );
cout << "Relative u1 L2 error = " << errL2 << endl;

errL2 = sqrt( int2d(Mh, qforder=6)((u2 - v22)^2) / int2d(Mh, qforder=6)(v22^2) );
cout << "Relative u2 L2 error = " << errL2 << endl;

